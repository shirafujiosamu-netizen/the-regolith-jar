/* 作品详情页共用样式：与主站 intro.html 同一套黑底细线米白字 */
:root {
  --bg: #000000;
  --ink: #ffffff;
  --muted: rgba(226, 230, 245, 0.68);
  --dim: rgba(200, 206, 230, 0.44);
  --violet: #9d7bff;
  --line: rgba(255, 255, 255, 0.08);
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  background-color: var(--bg);
  background-image:
    radial-gradient(circle at 18% 12%, rgba(157,123,255,.10), transparent 42%),
    radial-gradient(circle at 82% 74%, rgba(127,176,255,.08), transparent 46%);
  background-attachment: fixed;
  color: var(--ink);
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}
.wrap { width: min(1000px, 88vw); margin: 0 auto; }
nav.top {
  position: sticky; top: 0; z-index: 30; height: 54px;
  display: flex; align-items: center;
  backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
  background: rgba(10, 15, 26, 0.66);
  border-bottom: 1px solid var(--line);
}
nav.top .wrap { display: flex; align-items: center; justify-content: space-between; }
nav.top .brand { font-size: 12px; letter-spacing: .34em; color: var(--dim); }
nav.top a.back { font-size: 13px; color: var(--muted); text-decoration: none; }
nav.top a.back:hover { color: var(--ink); }
main { position: relative; z-index: 1; padding-bottom: 120px; }
section { padding: 70px 0; border-bottom: 1px solid var(--line); }
section:last-child { border-bottom: 0; }
.hero { padding: 120px 0 90px; text-align: center; border-bottom: 0; }
.hero .eyebrow, .block .eyebrow {
  font-size: 11px; letter-spacing: .3em; color: var(--violet); margin-bottom: 18px;
}
.hero h1 {
  font-size: clamp(34px, 5.2vw, 66px); font-weight: 200;
  letter-spacing: .12em; line-height: 1.2;
}
.hero .cap { margin-top: 26px; font-size: 13px; color: var(--dim); letter-spacing: .18em; }
.block h2 {
  font-size: clamp(21px, 2.2vw, 30px); font-weight: 400; line-height: 1.45;
  letter-spacing: .01em; margin-bottom: 18px;
}
.block p { font-size: 14.5px; line-height: 1.95; color: var(--muted); max-width: 760px; }
.block p + p { margin-top: 14px; }
ul.facts { margin-top: 26px; list-style: none; max-width: 760px; }
ul.facts li {
  font-size: 14px; color: var(--muted);
  padding: 12px 0 12px 20px; position: relative;
  border-top: 1px solid var(--line); line-height: 1.8;
}
ul.facts li:first-child { border-top: none; }
ul.facts li::before {
  content: ""; position: absolute; left: 0; top: 21px;
  width: 5px; height: 5px; border-radius: 50%; background: rgba(157,123,255,.8);
}
ul.facts li b { color: var(--ink); font-weight: 500; }
.shot {
  margin-top: 34px;
  border: 1px solid var(--line);
  border-radius: 16px;
  overflow: hidden;
  background: rgba(255,255,255,.02);
}
.shot img { display: block; width: 100%; height: auto; }
.shot figcaption {
  padding: 14px 18px; font-size: 12px; letter-spacing: .08em;
  color: var(--dim); border-top: 1px solid var(--line);
}
.stack { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 20px; margin-top: 34px; }
.stack .shot { margin-top: 0; }
.pager { display: flex; justify-content: space-between; gap: 20px; padding-top: 46px; font-size: 13px; }
.pager a { color: var(--muted); text-decoration: none; }
.pager a:hover { color: var(--ink); }
@media (max-width: 860px) {
  .stack { grid-template-columns: 1fr; }
  section { padding: 50px 0; }
  .hero { padding: 84px 0 60px; }
}
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
}
